# Orion environment template
# Copy this file to .env and fill values. Do not commit secrets.

# ── Core Runtime ──────────────────────────────────────────────────────────────
ORION_STAGE=paper
ORION_RUN_ID=local_run
ORION_API_KEY=replace-with-local-api-key
ORION_LOG_FORMAT=human
ORION_USE_GATEWAY=true
ORION_DB_ECHO=false
ORION_ARTIFACTS_DIR=artifacts
ORION_MODEL_DIR=/app/models
ORION_PROPOSALS_DIR=proposals

# ── Data Access + Storage Migration ───────────────────────────────────────────
DATA_GATEWAY_URL=http://localhost:8080
DATA_GATEWAY_API_KEY=
HEBER_CATALOG_URL=http://localhost:8085/api/v1
HEBER_DATA_ROOT=/Volumes/heber/data

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://orion:orion_password@localhost:5440/orion_db

# ── Provider Credentials ─────────────────────────────────────────────────────
UW_API_KEY=replace-with-uw-key
UW_BASE_URL=https://api.unusualwhales.com
ALPACA_API_KEY=replace-with-alpaca-key
ALPACA_SECRET_KEY=replace-with-alpaca-secret
ALPACA_PAPER=true

# ── Agent / Model Providers ──────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-openai-key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
ORION_REASONING_LEVEL=extra_high

# ── Feature Enrichment + Legacy Migration Gates ──────────────────────────────
ORION_FEATURE_ENRICHMENT_ENABLE_GATEWAY_FETCH=false
ORION_ENABLE_LEGACY_LABEL_PIPELINES=false
ORION_ENABLE_LEGACY_OPTION_QUOTE_TRACKER=false
ORION_ENABLE_LEGACY_PRICE_TARGET_LABELER=false
ORION_ENABLE_LEGACY_PATTERN_MINER=true
ORION_ENABLE_LEGACY_PATTERN_MINER_TRAINING=true
ORION_ENABLE_LEGACY_EXIT_CLASSIFIER_TRAINING=true
ORION_ENABLE_LEGACY_NIGHTLY_BACKFILL=false
ORION_ENABLE_LEGACY_QUALITY_GUARDRAILS=false
ORION_PATTERN_MINER_TRAINING_SOURCE=heber_gold
ORION_EXIT_CLASSIFIER_TRAINING_SOURCE=heber_gold

# ── Risk Controls ─────────────────────────────────────────────────────────────
ORION_RISK_MAX_DAILY_LOSS=1000
ORION_RISK_MAX_DRAWDOWN_PCT=0.05
ORION_RISK_MAX_POSITIONS=5
ORION_RISK_RISK_PER_TRADE_PCT=0.01
ORION_RISK_ENABLE_SHORTING=false
ORION_RISK_ENABLE_GREEKS_CHECKS=true
ORION_RISK_ENABLE_ZERO_DTE_WINDDOWN=true

# ── Metrics / Monitoring ──────────────────────────────────────────────────────
ORION_METRICS_ENABLED=false
ORION_METRICS_PORT=8000
MONITOR_LAG_THRESHOLD=300
MONITOR_DLQ_LOOKBACK=5

# ── Optional MinIO / Lakehouse ────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9005
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET=lakehouse
