<?xml version="1.0" encoding="UTF-8"?>
<!--
launchd agent for orion.main_meta_weekly --scheduled running natively on
macOS.

This is the FIRST production scheduler for meta-weekly. It replaces the
Docker `meta-weekly` service, which sat behind the never-`up` `scheduled`
compose profile (see proposals/2026-06-10-eod-meta-diagnosis.md
root-cause #2).

SHAPE: long-running KeepAlive daemon, NOT a StartCalendarInterval
one-shot. main_meta_weekly.py's `--scheduled` mode is an internal 60s
poll loop that self-fires on Friday 17:30 ET (the code's own target time,
"every Friday at 5:30 PM EST", after the daily EOD agent). The process
owns its own schedule, so launchd only keeps it alive — a calendar
one-shot cannot be used because the `--scheduled` loop never exits.

NOTE on schedule: the task brief suggested "Sunday 18:00 local" as an
example, but the code's `run_scheduled()` is hard-wired to Friday 17:30
ET and there is no CLI flag to change it. Because this plist runs the
daemon 24/7 and the *daemon* decides when to fire, the launchd plist does
not (and must not) impose a calendar time of its own — doing so would
fight the in-process scheduler. The effective run time is therefore
Friday 17:30 ET, single-sourced from the code.

Install:
    cp scripts/launchd/com.empire.orion.meta-weekly.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.empire.orion.meta-weekly.plist

Status:
    launchctl print gui/$(id -u)/com.empire.orion.meta-weekly

Stop / disable:
    launchctl bootout gui/$(id -u)/com.empire.orion.meta-weekly

Logs:
    tail -f logs/meta_weekly_native.log          # structured Python logs
    tail -f logs/meta_weekly_native.stdout.log   # launchd-captured stdout
    tail -f logs/meta_weekly_native.stderr.log   # launchd-captured stderr
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.empire.orion.meta-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jacobmcmillan/Empire/Orion/scripts/run_meta_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacobmcmillan/Empire/Orion</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive: the internal scheduler loop is the system of record for
         *when* the weekly evolution fires (Friday 17:30 ET); KeepAlive just
         ensures the loop is always alive across reboots/crashes. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jacobmcmillan</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jacobmcmillan/Empire/Orion/logs/meta_weekly_native.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobmcmillan/Empire/Orion/logs/meta_weekly_native.stderr.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
