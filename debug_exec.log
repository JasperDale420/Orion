            rule_id="test_rule",
            direction="LONG",
            confidence=0.9,
            source="TEST",
            execution_params={"limit_price": 100.0},
            evidence={"test": True}
        )
    
        # SYSTEM STATUS
        status = SystemStatus(
            key="global_health",
            status="HEALTHY",
            last_updated_utc=datetime.now(timezone.utc),
            details="Test"
        )
    
        async with test_session_factory() as session:
            session.add(candidate)
            session.add(status)
            await session.commit()
    
        # DEBUG DB CONTENT
        async with test_session_factory() as session:
            all_c = (await session.execute(select(CandidateTrade))).scalars().all()
            print(f"DEBUG: Total Candidates in DB: {len(all_c)}")
            for c in all_c:
                print(f"DEBUG: Cand: {c.candidate_id}, {c.ticker}")
    
